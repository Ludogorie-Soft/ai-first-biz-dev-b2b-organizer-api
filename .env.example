# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: Supabase Dashboard → Settings → Data API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Direct Postgres URI for applying supabase/migrations/*.sql locally.
# Supabase Dashboard → Project Settings → Database → Connection string → URI (port 5432).
# Not used by the API or worker. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ── AWS SES ───────────────────────────────────────────────────────────────────
# Create an IAM user with AmazonSESFullAccess, then copy the key from AWS Console
# Required on API (system mail + SES identity checks) and worker (campaign sends)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# SES region where your sending identity is verified, e.g. eu-west-1 or us-east-1
AWS_REGION=eu-west-1
# System FROM address (invites, verification, admin notify) — API / Vercel only
# Must be a verified identity in SES. Campaign From uses each mailbox.email instead.
SES_FROM_EMAIL=outreach@yourdomain.com
# Random secret to protect the SES bounce/complaint webhook URL — API / Vercel only
# Without this the /webhooks/ses endpoint is publicly accessible — always set in production
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SES_WEBHOOK_SECRET=generate-a-random-string-here

# ── IMAP encryption ───────────────────────────────────────────────────────────
# 32 random bytes as 64 hex characters — used to encrypt mailbox IMAP passwords at rest
# Required on API (encrypt on create) and worker (decrypt for reply catcher)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMAP_ENCRYPTION_KEY=your-64-hex-char-key

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public base URL of the frontend app — used in invitation, verification & unsubscribe emails
# Dev: http://localhost:3001   Prod: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3001
# Public base URL of this API — used in List-Unsubscribe email headers (RFC 8058)
# Dev: http://localhost:3000   Prod (Vercel): https://your-project.vercel.app
API_URL=http://localhost:3000

# ── App (optional) ────────────────────────────────────────────────────────────
# Defaults to 3000. Used by local `npm run start` / `dev:api` only (not Vercel).
PORT=3000
# Defaults to "development". Set to "production" on Vercel / Docker.
NODE_ENV=development
