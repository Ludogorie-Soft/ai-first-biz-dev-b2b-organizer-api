# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Upstash)
REDIS_URL=rediss://default:password@host:port

# AWS SES
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
SES_FROM_EMAIL=outreach@yourdomain.com
# Secret token to protect the SES bounce webhook endpoint
SES_WEBHOOK_SECRET=generate-a-random-string-here

# Encryption (32 bytes as 64 hex characters)
IMAP_ENCRYPTION_KEY=your-64-hex-char-key

# App
PORT=3000
NODE_ENV=development
