# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: Supabase Dashboard → Settings → Data API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis Cloud / Upstash connection string
# Format: redis://default:PASSWORD@HOST:PORT  (plain)
#      or rediss://default:PASSWORD@HOST:PORT  (TLS — recommended for cloud)
REDIS_URL=rediss://default:password@host:port

# ── AWS SES ───────────────────────────────────────────────────────────────────
# Create an IAM user with AmazonSESFullAccess, then copy the key from AWS Console
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# SES region where your sending identity is verified, e.g. eu-west-1 or us-east-1
AWS_REGION=eu-west-1
# The FROM address — must be a verified identity in SES
SES_FROM_EMAIL=outreach@yourdomain.com
# Random secret to protect the SES bounce/complaint webhook URL
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SES_WEBHOOK_SECRET=generate-a-random-string-here

# ── IMAP encryption ───────────────────────────────────────────────────────────
# 32 random bytes as 64 hex characters — used to encrypt mailbox IMAP passwords at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMAP_ENCRYPTION_KEY=your-64-hex-char-key

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public base URL of the frontend app — used in invitation & admin notification emails
# Dev: http://localhost:3001   Prod: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3001
# Public base URL of this API — used in List-Unsubscribe email headers (RFC 8058)
# Dev: http://localhost:3000   Prod: https://api.yourdomain.com
API_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
