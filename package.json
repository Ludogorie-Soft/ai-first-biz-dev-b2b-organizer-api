{
  "name": "b2b-organizer-api",
  "version": "1.0.0",
  "description": "B2B Outreach Platform API",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc && npm run build:openapi",
    "build:openapi": "node scripts/generate-openapi.js",
    "start": "node dist/src/server.js",
    "worker": "node dist/worker.js",
    "dev": "concurrently -n api,worker -c blue,green \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only worker.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/node": "^5.3.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "imapflow": "^1.0.169",
    "mailparser": "^3.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.17.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
